{
  "name": "eduteams",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --no-engine && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:ci": "biome lint .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "bun test",
    "test:grey": "bun run scripts/test-grey.ts",
    "db:seed": "bun run prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && bun run db:seed",
    "assets:normalize-mbti": "bun run scripts/normalize-mbti-svgs.ts",
    "reports:generate": "bun run scripts/generate-test-report.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@paralleldrive/cuid2": "^2.3.0",
    "@prisma/client": "^6.18.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "better-auth": "^1.3.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.541.0",
    "next": "15.4.1",
    "next-intl": "^4.4.0",
    "nuqs": "^2.7.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "recharts": "2.15.4",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.7",
    "@happy-dom/global-registrator": "^18.0.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/node": "^20.19.23",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "bun-types": "^1.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prisma": "^6.18.0",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "postcss": "^8.5.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched",
      "biome format --write"
    ],
    "*.{json,md,css}": ["biome format --write"]
  }
}
