# Database (matches docker-compose defaults)
POSTGRES_DB="eduteams"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://user:password@localhost:5432/eduteams"

# Public app URL (used for redirects, CSRF origin checks, share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="replace-with-strong-random-secret"
# Single source of truth for the auth origin used by OAuth callbacks and cookies
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"


# Node environment (overridden by hosting platform)
NODE_ENV="development"

# Development flags
DEV_DISABLE_AUTO_ROLE="false"
NEXT_PUBLIC_DISABLE_INSTITUTIONAL_EMAIL="0"
ENFORCE_SAME_ORIGIN_MUTATIONS="1"
# Extra trusted origins for local development only, e.g. "http://192.168.1.10:3000"
DEV_ALLOWED_ORIGINS=""
# Self-hosted proxy headers to trust for IP-based rate limiting, e.g. "x-forwarded-for"
TRUSTED_CLIENT_IP_HEADERS=""
# If x-forwarded-for includes trusted proxy hops on the right, skip them here.
TRUSTED_PROXY_HOPS="0"

# Team formation
# Self-hosted installs should usually keep this on "local".
# Set to "edu2com" only after configuring the public webhook values below.
TEAM_FORMATION_PROVIDER="local"

# External services
# EDU2COM_TIMEOUT_MS=120000
# EDU2COM_BACKGROUND_TIMEOUT_MS=180000
# EDU2COM_ALPHA_WEIGHT=0.4
# EDU2COM_BETA_WEIGHT=0.3
# EDU2COM_GAMMA_WEIGHT=0.2
# EDU2COM_DELTA_WEIGHT=0.1
EDU2COM_INTEGRATION=0
# Required when TEAM_FORMATION_PROVIDER=edu2com
EDU2COM_WEBHOOK_SECRET="replace-with-strong-secret"
# Required when TEAM_FORMATION_PROVIDER=edu2com. Must be your public app origin.
EDU2COM_WEBHOOK_BASE_URL="https://your-public-app.example.com"

# Vercel Cron Jobs (required for automatic cleanup of stale requests)
# Generate with: openssl rand -hex 32
# Vercel automatically sends this as "Authorization: Bearer $CRON_SECRET" header
CRON_SECRET="replace-with-strong-random-secret"

# Deployment configuration:
# - All deployments require BETTER_AUTH_SECRET
# - Auth startup also requires BETTER_AUTH_URL, GOOGLE_CLIENT_ID, and GOOGLE_CLIENT_SECRET
# - TEAM_FORMATION_PROVIDER=edu2com requires EDU2COM_WEBHOOK_SECRET and EDU2COM_WEBHOOK_BASE_URL
# - Managed Vercel production defaults to TEAM_FORMATION_PROVIDER=edu2com unless overridden
