{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/error.tsx",
        "src/app/**/loading.tsx",
        "src/app/**/route.ts",
        "__tests__/setup.ts",
        "__tests__/dom-setup.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "types/**/*.d.ts", "prisma/**/*.ts"],
      "ignoreFiles": ["src/generated/**", ".next/**", "src/i18n/request.ts"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
    }
  }
}
