# Server
DATABASE_URL="postgresql://user:password@localhost:5432/eduteams"

# Public app URL (used for redirects, CSRF origin checks, share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Upstash Redis (optional, used for caching/ratelimiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Node environment (overridden by hosting platform)
NODE_ENV="development"

