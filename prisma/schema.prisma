generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "./dbml"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                      @id
  name                      String
  email                     String                      @unique
  emailVerified             Boolean
  image                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  isOnboarded               Boolean                     @default(false)
  hasSeenWelcomeSplash      Boolean                     @default(false)
  nim                       String?
  role                      RoleName?
  onboardingData            Json?
  onboardingStep            String?
  gender                    Gender?
  personalityProfile        PersonalityProfile?
  personalitySessions       PersonalitySession[]
  accounts                  Account[]
  personPreferences         PersonPreference[]
  preferredBy               PersonPreference[]          @relation("PreferredPerson")
  personSkills              PersonSkill[]
  sessions                  Session[]
  taskPreferences           TaskPreference[]
  ownedTeamRequests         TeamFormationRequest[]      @relation("TeamRequestOwner")
  teamMemberships           TeamMember[]
  courses                   Course[]
  courseEnrollments         CourseEnrollment[]
  dosenTokenUsages          DosenTokenUsage[]
  createdAssignments        Assignment[]                @relation("AssignmentCreator")
  assignmentSubmissions     AssignmentSubmission[]      @relation("AssignmentSubmissionStudent")
  AssignmentTopicPreference AssignmentTopicPreference[]
  competencyProfiles        StudentCompetencyProfile[]

  @@index([role])
  @@index([isOnboarded])
  @@index([onboardingStep])
  @@index([onboardingData], type: Gin)
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Skill {
  id              String                     @id @default(uuid())
  name            String                     @unique
  description     String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  personSkills    PersonSkill[]
  sourceRelations SkillSimilarity[]          @relation("SourceSkill")
  targetRelations SkillSimilarity[]          @relation("TargetSkill")
  taskSkills      TaskSkill[]
  studentProfiles StudentCompetencyProfile[]
  courseSkills    CourseSkill[]

  @@index([name])
  @@map("skills")
}

model PersonSkill {
  id        String   @id @default(uuid())
  personId  String
  skillId   String
  level     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  person    User     @relation(fields: [personId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([personId, skillId])
  @@index([personId])
  @@index([skillId])
  @@map("person_skills")
}

model PersonPreference {
  id                String   @id @default(uuid())
  personId          String
  preferredPersonId String
  preference        Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  person            User     @relation(fields: [personId], references: [id], onDelete: Cascade)
  preferredPerson   User     @relation("PreferredPerson", fields: [preferredPersonId], references: [id], onDelete: Cascade)

  @@unique([personId, preferredPersonId])
  @@index([personId])
  @@index([preferredPersonId])
  @@map("person_preferences")
}

model SkillSimilarity {
  id          String   @id @default(uuid())
  sourceId    String
  targetId    String
  similarity  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceSkill Skill    @relation("SourceSkill", fields: [sourceId], references: [id], onDelete: Cascade)
  targetSkill Skill    @relation("TargetSkill", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@map("skill_similarities")
}

model Task {
  id          String           @id @default(uuid())
  name        String
  description String?
  teamSize    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  preferences TaskPreference[]
  skills      TaskSkill[]
  teams       Team[]

  @@index([teamSize])
  @@map("tasks")
}

model TaskSkill {
  id         String   @id @default(uuid())
  taskId     String
  skillId    String
  level      Float
  importance Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, skillId])
  @@index([taskId])
  @@index([skillId])
  @@map("task_skills")
}

model TaskPreference {
  id         String   @id @default(uuid())
  taskId     String
  personId   String
  preference Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  person     User     @relation(fields: [personId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, personId])
  @@index([taskId])
  @@index([personId])
  @@map("task_preferences")
}

model TeamFormationRequest {
  id           String              @id @default(uuid())
  ownerId      String
  assignmentId String?
  status       TeamFormationStatus @default(PENDING)
  alpha        Float?
  beta         Float?
  gamma        Float?
  delta        Float?
  initRandom   Boolean             @default(false)
  requestData  Json?
  responseData Json?
  errorMessage String?
  replyPostUrl String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  completedAt  DateTime?
  owner        User                @relation("TeamRequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignment   Assignment?         @relation("TeamFormationAssignment", fields: [assignmentId], references: [id], onDelete: SetNull)
  teams        Team[]

  @@index([status, createdAt])
  @@index([ownerId])
  @@index([assignmentId])
  @@index([requestData], type: Gin)
  @@index([responseData], type: Gin)
  @@map("team_formation_requests")
}

model Team {
  id                     String               @id @default(uuid())
  teamFormationRequestId String
  taskId                 String?
  name                   String?
  quality                Float?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  members                TeamMember[]
  task                   Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  teamFormationRequest   TeamFormationRequest @relation(fields: [teamFormationRequestId], references: [id], onDelete: Cascade)

  @@index([teamFormationRequestId])
  @@index([taskId])
  @@map("teams")
}

model TeamMember {
  id               String   @id @default(uuid())
  teamId           String
  userId           String
  assignedSkillIds String[]
  createdAt        DateTime @default(now())
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([assignedSkillIds], type: Gin)
  @@map("team_members")
}

model Course {
  id                String             @id @default(uuid())
  namaMataKuliah    String
  kelas             String
  tahunAwalPeriode  Int
  tahunAkhirPeriode Int
  periode           String
  dosenId           String
  shareToken        String?            @unique @default(cuid())
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dosen             User               @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  enrollments       CourseEnrollment[]
  assignments       Assignment[]
  courseSkills      CourseSkill[]

  @@index([dosenId])
  @@index([tahunAwalPeriode, tahunAkhirPeriode])
  @@index([periode])
  @@index([archivedAt])
  @@map("courses")
}

model CourseSkill {
  id        String   @id @default(uuid())
  courseId  String
  skillId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
  @@index([courseId])
  @@index([skillId])
  @@map("course_skills")
}

model CourseCatalog {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("course_catalogs")
}

model ClassCatalog {
  id        String   @id @default(uuid())
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("class_catalogs")
}

model CourseEnrollment {
  id         String   @id @default(uuid())
  courseId   String
  studentId  String
  enrolledAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@map("course_enrollments")
}

model DosenToken {
  id          String            @id @default(uuid())
  token       String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  usages      DosenTokenUsage[]

  @@map("dosen_tokens")
}

model DosenTokenUsage {
  id        String     @id @default(uuid())
  tokenId   String
  userId    String
  usedAt    DateTime   @default(now())
  createdAt DateTime   @default(now())
  token     DosenToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenId, userId])
  @@index([tokenId])
  @@index([userId])
  @@map("dosen_token_usage")
}

enum Gender {
  FEMALE
  MALE
}

enum TeamFormationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum MBTIType {
  ENFJ
  ENFP
  ENTJ
  ENTP
  ESFJ
  ESFP
  ESTJ
  ESTP
  INFJ
  INFP
  INTJ
  INTP
  ISFJ
  ISFP
  ISTJ
  ISTP
}

enum AssignmentStatus {
  BELUM_ISI
  MENUNGGU
  BERHASIL_PEMBAGIAN_GRUP
}

enum PersonalityAxis {
  EI @map("ei")
  SN @map("sn")
  TF @map("tf")
  PJ @map("pj")
  I  @map("i")
  E  @map("e")
  S  @map("s")
  N  @map("n")
  F  @map("f")
  T  @map("t")
  J  @map("j")
  P  @map("p")
  NJ @map("nj")
  NP @map("np")
  SJ @map("sj")
  SP @map("sp")
  EF @map("ef")
  ET @map("et")
  IF @map("if")
  IT @map("it")
}

enum PersonalityBankStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CompetencyKind {
  SKILL
  TOPIC
}

model Assignment {
  id                    String                     @id @default(uuid())
  courseId              String
  createdById           String
  title                 String
  description           String?
  startAt               DateTime                   @default(now())
  status                AssignmentStatus           @default(BELUM_ISI)
  structureVersion      Int                        @default(1)
  structureUpdatedAt    DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  archivedAt            DateTime?
  course                Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy             User                       @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  submissions           AssignmentSubmission[]
  AssignmentTopic       AssignmentTopic[]
  snapshots             AssignmentSnapshot[]
  teamFormationRequests TeamFormationRequest[]     @relation("TeamFormationAssignment")
  competencyProfiles    StudentCompetencyProfile[]

  @@index([courseId])
  @@index([status])
  @@index([createdById])
  @@map("assignments")
}

model AssignmentSnapshot {
  id             String     @id @default(uuid())
  assignmentId   String
  version        Int
  title          String
  description    String?
  snapshotAt     DateTime   @default(now())
  snapshotReason String?
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, version])
  @@index([assignmentId])
  @@map("assignment_snapshots")
}

model AssignmentSubmission {
  id               String     @id @default(uuid())
  assignmentId     String
  studentId        String
  structureVersion Int        @default(1)
  needsUpdate      Boolean    @default(false)
  createdAt        DateTime   @default(now())
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          User       @relation("AssignmentSubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([needsUpdate])
  @@map("assignment_submissions")
}

// Normalize assignment-specific topics and preferences without polluting global Task/TaskPreference
model AssignmentTopic {
  id           String                      @id @default(uuid())
  assignmentId String
  name         String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  assignment   Assignment                  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  preferences  AssignmentTopicPreference[]

  @@unique([assignmentId, name])
  @@index([assignmentId])
  @@map("assignment_topics")
}

model AssignmentTopicPreference {
  id                String          @id @default(uuid())
  assignmentTopicId String
  personId          String
  preference        Float
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  topic             AssignmentTopic @relation(fields: [assignmentTopicId], references: [id], onDelete: Cascade)
  person            User            @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([assignmentTopicId, personId])
  @@index([assignmentTopicId])
  @@index([personId])
  @@map("assignment_topic_preferences")
}

// SKILL rows must provide skillId (topicKey null) while TOPIC rows do the inverse.
model StudentCompetencyProfile {
  id                 String         @id @default(uuid())
  studentId          String
  competencyKind     CompetencyKind
  skillId            String?
  topicKey           String?
  value              Float
  sourceAssignmentId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  student            User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill              Skill?         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sourceAssignment   Assignment?    @relation(fields: [sourceAssignmentId], references: [id], onDelete: SetNull)

  @@unique([studentId, competencyKind, skillId])
  @@unique([studentId, competencyKind, topicKey])
  @@index([studentId])
  @@index([skillId])
  @@index([topicKey])
  @@index([sourceAssignmentId])
  @@map("student_competency_profiles")
}

model PersonalityQuestion {
  id               String                @id @default(uuid())
  bankVersion      Int
  status           PersonalityBankStatus @default(ACTIVE)
  text             String
  dimension        PersonalityAxis
  orderHint        Int
  reversed         Boolean               @default(false)
  isAttentionCheck Boolean               @default(false)
  locale           String                @default("id-ID")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  responses        PersonalityResponse[]

  @@unique([bankVersion, orderHint, locale])
  @@index([bankVersion, status])
  @@index([dimension])
  @@map("personality_questions")
}

model PersonalitySession {
  id              String                @id @default(uuid())
  userId          String
  bankVersion     Int
  presentedOrder  Json
  startedAt       DateTime              @default(now())
  submittedAt     DateTime?
  durationMs      Int?
  attentionPassed Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses       PersonalityResponse[]
  score           PersonalityScore?

  @@index([userId])
  @@index([bankVersion])
  @@index([bankVersion, submittedAt])
  @@index([attentionPassed, submittedAt])
  @@index([createdAt])
  @@index([submittedAt])
  @@map("personality_sessions")
}

model PersonalityProfile {
  userId          String    @id
  ei              Float?
  sn              Float?
  tf              Float?
  pj              Float?
  mbtiType        MBTIType?
  personalityData Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mbtiType])
  @@index([ei])
  @@index([sn])
  @@index([tf])
  @@index([pj])
  @@index([personalityData], type: Gin)
  @@map("personality_profiles")
}

model PersonalityResponse {
  id          String              @id @default(uuid())
  sessionId   String
  questionId  String
  rawValue    Int
  scoredValue Int?
  position    Int
  createdAt   DateTime            @default(now())
  session     PersonalitySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question    PersonalityQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("personality_responses")
}

model PersonalityScore {
  sessionId String             @id
  ei        Float
  sn        Float
  tf        Float
  pj        Float
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  session   PersonalitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("personality_scores")
}
